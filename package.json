{
  "name": "cosmos-visualizer",
  "version": "1.0.0",
  "author": "Umesh Jayasinghe",
  "description": "Explore Azure Cosmos DB Gremlin graphs locally",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@material-ui/core": "^4.7.0",
    "@material-ui/icons": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gremlin": "^3.8.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-json-to-table": "^0.1.5",
    "react-redux": "^7.1.3",
    "redux": "^4.0.4",
    "redux-logger": "^3.0.6",
    "vis-network": "^6.4.4"
  },
  "scripts": {
    "client": "vite --host 0.0.0.0",
    "server": "node proxy-server.js",
    "server:fixture": "USE_FIXTURE_DATA=true node proxy-server.js",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "start:fixture": "USE_FIXTURE_DATA=true concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "supertest": "^7.1.4",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
